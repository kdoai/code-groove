  "sources": {
    "README.md": "# 理由のある契約の違い\n公開サンプルの返金アプリ。返金条件、返金額、通知本文が対象です。\n似た条件でも、法人契約には別の理由がある。\n",
    "src/consumer-policy.ts": "export function consumerRefund(\n  price: number, daysSincePurchase: number, isFinalSale: boolean,\n  hasReceipt: boolean, customerName: string,\n) {\n  return daysSincePurchase <= 30 && !isFinalSale;\n}\n",
    "src/enterprise-policy.ts": "export function enterpriseRefund(\n  price: number, daysSincePurchase: number, isFinalSale: boolean,\n  hasReceipt: boolean, customerName: string,\n) {\n  const contractedWindow = 90;\n  return daysSincePurchase <= contractedWindow && hasReceipt;\n}\n",
    "src/notification.ts": "export function buildNotification(\n  price: number, daysSincePurchase: number, isFinalSale: boolean,\n  hasReceipt: boolean, customerName: string,\n) {\n  return `${customerName}: ${price} yen refunded`;\n}\n",
    "src/refund-amount.ts": "export function calculateRefund(\n  price: number, daysSincePurchase: number, isFinalSale: boolean,\n  hasReceipt: boolean, customerName: string,\n) {\n  return Math.max(0, price - Math.round(price * 0.05));\n}\n",
    "tests/enterprise-policy.test.ts": "// Contract: enterprise customers have a 90-day refund window.\nimport { enterpriseRefund } from '../src/enterprise-policy';\n// Boundary examples: 60 days accepted, 91 days rejected.\nexport const examples = [{ days: 60, eligible: true }, { days: 91, eligible: false }];\n"
  },
